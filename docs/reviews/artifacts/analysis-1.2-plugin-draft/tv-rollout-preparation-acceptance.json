    "policyExcerpt": "import AetherJellyfin\n\n/// Local, explicitly reviewed directions. Server rows can restrict these,\n/// never expand them through SemVer or a draft suffix transformation.\n/// Internal injection is used only by isolated rollout tests. The public\n/// supply initializer always installs the unchanged production policy.\nstruct AnalysisReadPolicy: Sendable {\n    struct Direction: Sendable {\n        let reader: PluginAlgorithm\n        let analyses: [PluginAlgorithm]\n    }\n\n    let directions: [Direction]\n\n    static let production: AnalysisReadPolicy = {\n        // Keep these accepted directions explicit. Adding a future reader to\n        // another allowlist must not authorize older readers to consume it.\n        let legacy = [PluginAlgorithm(id: \"aether-visual\", version: \"1.1.0\"),\n            PluginAlgorithm(id: \"aether-visual\", version: \"1.0.0\")]\n        return AnalysisReadPolicy(directions: legacy.map {\n            Direction(reader: $0, analyses: legacy)\n        })\n    }()\n\n    func supports(_ reader: PluginAlgorithm) -> Bool {\n        directions.contains { $0.reader == reader }\n    }\n\n    func analyses(for reader: PluginAlgorithm) -> [PluginAlgorithm] {\n        directions.first { $0.reader == reader }?.analyses ?? []\n    }\n\n    func allows(_ analysis: PluginAlgorithm, for reader: PluginAlgorithm) -> Bool {\n        analysis.id == reader.id && analyses(for: reader).contains(analysis)\n    }\n\n    func advertisedVersions(_ versions: [String], for reader: PluginAlgorithm) -> [String]? {\n        guard versions.first == reader.version,\n            Set(versions).count == versions.count,\n            versions.allSatisfy({ allows(.init(id: reader.id, version: $0), for: reader) })\n        else { return nil }\n        return versions\n    }\n}\n",
    "supplyInitializerLines": [
      "    public init(",
